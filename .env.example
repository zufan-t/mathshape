# ============================================================
# MathLearn — Environment Variables
# Salin file ini ke .env dan isi nilainya sebelum menjalankan
# ============================================================

# -----------------------------------------------------------
# Supabase (Auth + Database PostgreSQL)
# Dapatkan nilai ini di: https://app.supabase.com → Settings → API
# -----------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# -----------------------------------------------------------
# REST API Backend
# URL server backend (Express / FastAPI / dll.)
# -----------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000
VITE_API_VERSION=v1

# -----------------------------------------------------------
# App Environment
# Nilai: development | staging | production
# -----------------------------------------------------------
VITE_APP_ENV=development
