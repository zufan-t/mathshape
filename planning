## 🗄️ Database Schema (Supabase PostgreSQL)

```mermaid
erDiagram
    USERS ||--o{ USER_PROGRESS : has
    MATERIALS ||--o{ MATERIAL_PAGES : contains
    MATERIALS ||--o{ USER_PROGRESS : tracked_by
    MATERIAL_PAGES ||--o{ QUESTIONS : may_have

    USERS {
        uuid id PK
        string email
        string full_name
        string avatar_url
        timestamp created_at
    }

    MATERIALS {
        int id PK
        string title
        string description
        int order_number
        string thumbnail_url
        int total_pages
    }

    MATERIAL_PAGES {
        int id PK
        int material_id FK
        int page_number
        text content_json
        boolean has_questions
    }

    QUESTIONS {
        int id PK
        int page_id FK
        text question_text
        jsonb options
        string correct_answer
    }

    USER_PROGRESS {
        int id PK
        uuid user_id FK
        int material_id FK
        int current_page
        int score
        boolean is_completed
        timestamp started_at
        timestamp completed_at
    }
```

